# Generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App (not a PAT). Callback URL:
# http://localhost:3000/api/auth/callback/github
# Scopes requested by the app: repo, read:org
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_URL=http://localhost:3000

# Postgres. Use letters and numbers only; this password is embedded in DATABASE_URL.
# Local `npm run dev` talks to Postgres on localhost. Compose rewrites DATABASE_URL
# for the app container so it uses the postgres service hostname.
POSTGRES_USER=reposhild
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reposhild
POSTGRES_PORT=5432
APP_PORT=3210
DATABASE_URL=postgresql://reposhild:change-me@localhost:5432/reposhild?schema=public

# Set on the VPS when the app image is pushed to a registry.
# REPOSHILD_IMAGE=your-dockerhub-user/reposhild:latest
